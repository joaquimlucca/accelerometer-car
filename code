#include <Wire.h>
#include <MPU6050_light.h>
#include <Ultrasonic.h>
#include <L298NX2.h>
MPU6050 mpu(Wire);
Ultrasonic distance(11, 2, 40000UL);
L298NX2 motors(3, 5, 6, 9);
float correctbrut = 0;
float correctInvbrut = 0;
int correct = 0;
int correctInv = 0;
unsigned long time = 0;
unsigned long timeN = 0;
const int interval = 500;
int speedA = 150;
int speedB = 150;

void setup() {
  Serial.begin(9600);
  Wire.begin();
  Wire.setClock(400000);
  byte beginMpu = mpu.begin();
  if (beginMpu != 0) {
    Serial.println("Deu merda no MPU ja");
    while (beginMpu != 0)
      ;
  }
  Serial.println("Começou funcionando");
  mpu.calcOffsets();
  motors.setSpeed(0);
  motors.forward();
  time = millis();
}

void loop() {
  timeN = millis();
  mpu.update();
  float Z = mpu.getAngleZ();
  Z = constrain(Z, -90, 90);
  float D = distance.read();
  if (Z > 0) {
    correctbrut = (150 + Z);
    correct = (int)correctbrut;
    correctInvbrut = (150 - Z);
    correctInv = (int)correctInvbrut;
    speedA = correctInv;
    speedB = correct;
  } else if (Z < 0) {
    correctbrut = (150 + (Z * -1));
    correct = (int)correctbrut;
    correctInvbrut = (150 - (Z * -1));
    correctInv = (int)correctInvbrut;
    speedA = correct;
    speedB = correctInv;
  }
  speedA = speedA - 30;
  motors.setSpeedA(speedA);
  motors.setSpeedB(speedB);
  if (timeN - time >= interval) {
    Serial.print("Distance: ");
    Serial.println(D);
    Serial.print("Angle Z: ");
    Serial.println(Z);
    Serial.print("Speed A:");
    Serial.println(speedA);
    Serial.print("Speed B:");
    Serial.println(speedB);
    time = timeN;
  }
}
