#include <Wire.h>
#include <MPU6050_light.h>
#include <Ultrasonic.h>
#include <L298NX2.h>
MPU6050 mpu(Wire);
Ultrasonic distance(11, 2, 40000UL);
L298NX2 motors(3, 5, 6, 9);
float correctbrut = 0;
float correctInvbrut = 0;
int correct = 0;
int correctInv = 0;
unsigned long time = 0;
unsigned long timeN = 0;
const int interval = 500;

void setup()
{
  Serial.begin(9600);
  Wire.begin();
  Wire.setClock(400000);
  byte beginMpu = mpu.begin();
  if (beginMpu != 0)
  {
    Serial.println("Deu merda no MPU ja");
    while(beginMpu != 0);
  }
  Serial.println("Começou funcionando");
  mpu.calcOffsets();
  motors.setSpeed(0);
  motors.forward();
  time = millis();
}

void loop()
{
  timeN = millis();
  mpu.update();
  float Z = mpu.getAngleZ();
  Z = fmod(Z, 90.0);
  float D = distance.read();
  if (timeN - time >= interval)
  {
    Serial.print("Distance: ");
    Serial.println(D);
    Serial.print("Angle Z: ");
    Serial.println(Z);
    Serial.print("Correction1:" );
    Serial.println(correct);
    Serial.print("Correction2:" );
    Serial.println(correctInv);
    time = timeN;
  }
  if (Z > 0)
  {
    correct = (150 + Z);
    correct = (int)correctbrut;
    correctInv = (150 - Z);
    correctInv = (int)correctInvbrut;
    motors.setSpeedA(correctInv);
    motors.setSpeedB(correct);
  }
  else if (Z < 0)
  {
    correct = (150 + (Z * -1));
    correct = (int)correctbrut;
    correctInv = (150 - (Z * -1));
    correctInv = (int)correctInvbrut;
    motors.setSpeedA(correct);
    motors.setSpeedB(correctInv);
  }
}
